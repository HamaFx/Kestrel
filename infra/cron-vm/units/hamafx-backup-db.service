[Unit]
Description=HamaFX-Ai nightly Postgres dump → B2 (opt-in)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hamafx
Group=hamafx
WorkingDirectory=/opt/hamafx
EnvironmentFile=/opt/kestrel/.env
# Keep this timer installed but skipped until the B2 account is configured.
ExecCondition=/opt/hamafx/scripts/backup-storage-ready.sh
ExecStart=/opt/hamafx/scripts/backup-db.sh

# A full dump of the existing schema is well under 1G; this leaves
# headroom for embeddings growth.
MemoryMax=1G
TimeoutStartSec=1800

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hamafx /tmp

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hamafx-backup-db
