FROM node:22.23.3-slim@sha256:efd0ab5780c2d9ab1f0f869571a00d5edb17793bff4cce4a2792e3eb0ffc7562 AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@12.14.0 --activate
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json .npmrc ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/ai/package.json packages/ai/
COPY packages/config/package.json packages/config/
COPY packages/data/package.json packages/data/
COPY packages/db/package.json packages/db/
COPY packages/indicators/package.json packages/indicators/
COPY packages/shared/package.json packages/shared/
COPY packages/plugin-sdk/package.json packages/plugin-sdk/
# @kestrel:plugin-package-json-start
COPY plugins/package.json plugins/
COPY plugins/backtesting/package.json plugins/backtesting/
COPY plugins/custom-agents/package.json plugins/custom-agents/
COPY plugins/paper-trading/package.json plugins/paper-trading/
COPY plugins/telegram-bot/package.json plugins/telegram-bot/
# @kestrel:plugin-package-json-end
COPY patches/ patches/

# OPT-2: pnpm store cache mount persists across builds.
# OPT-7: Install only the worker's dependency graph. The previous full
# workspace install pulled every web dependency (Next.js/React tooling,
# Playwright, Tailwind, jsdom, ...) that this image never uses — the dominant
# cost of a cold build on small VMs. `--filter "@kestrel/worker..."` selects
# the worker plus the workspace packages it depends on (plugins included);
# `--filter .` keeps the root tooling (`turbo`) the builder stage needs.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter "@kestrel/worker..." --filter .

# OPT-6: Prune to the production dependency tree here, in the deps stage,
# where it only re-runs when package.json/lockfile change. Placing it after
# COPY . . in the builder stage cost ~85s per source-only rebuild.
RUN pnpm --filter=@kestrel/worker deploy --prod /prod/worker

FROM base AS builder
# OPT-3: --link creates node_modules as a separate reusable layer.
COPY --link --from=deps /app/node_modules ./node_modules
COPY --link --from=deps /app/pnpm-lock.yaml ./
COPY --link --from=deps /prod/worker ./prod/worker
COPY --link . .

# OPT-4: Cache turbo's `.turbo` output across rebuilds. Do NOT cache
# `apps/worker/dist`: the worker build script cleans that directory with
# `rmSync`, and a cache mount there makes the rmdir fail with EBUSY.
RUN --mount=type=cache,id=turbo-worker,target=/app/.turbo \
    pnpm turbo run build --filter=@kestrel/worker...

# Copy built dist/ files into the deployed package
RUN cp -r apps/worker/dist prod/worker/dist

FROM node:22.23.3-slim@sha256:efd0ab5780c2d9ab1f0f869571a00d5edb17793bff4cce4a2792e3eb0ffc7562 AS runner
ARG DEPLOYED_SHA=unknown
LABEL org.opencontainers.image.title="Kestrel worker" \
      org.opencontainers.image.source="https://github.com/HamaFx/Kestrel" \
      org.opencontainers.image.revision="${DEPLOYED_SHA}" \
      org.opencontainers.image.version="${DEPLOYED_SHA}"
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# OPT-5: --chown on COPY instead of a separate chown -R step.
# --chown with numeric UID (1000:1000 = node user) because --link creates a
# separate layer where the named user isn't resolvable from /etc/passwd.
COPY --link --chown=1000:1000 --from=builder /app/prod/worker ./

ENV DEPLOYED_SHA=${DEPLOYED_SHA}

ENV NODE_ENV=production
ENV WORKER_MODE=docker
# SEC-4: OpenSSL legacy provider flag REMOVED. Robust PEM normalization
# in packages/ai/src/model.ts and byok-providers.ts handles flat/escaped
# keys, so modern OpenSSL 3.x works without the legacy provider.
# If Google Auth JWT signing fails after this change, verify the
# normalizePemPrivateKey() function covers your key format.

EXPOSE 8081 8082

# SEC-3: Run as non-root user.
# The Node.js 22 slim image provides uid 1000 as 'node'.
# Ports 8081/8082 are >1024 so non-root binding works.
USER node

# SEC-3: Container HEALTHCHECK against the real worker health endpoint.
# Production containers always set WORKER_HEALTH_TOKEN via the runtime
# environment. Docker stores HEALTHCHECK commands verbatim (no build-time
# substitution happens here), so a single `$` reaches the container shell and
# expands at runtime. `$$` — the compose-file convention — would stay literal,
# send "Bearer <pid>{WORKER_HEALTH_TOKEN}", and 401 forever.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS -H "Authorization: Bearer ${WORKER_HEALTH_TOKEN}" http://localhost:8081/health/live && curl -fsS -H "Authorization: Bearer ${WORKER_HEALTH_TOKEN}" http://localhost:8081/health/jobs

CMD ["node", "dist/index.js"]
