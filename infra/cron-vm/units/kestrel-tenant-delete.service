[Unit]
Description=Kestrel weekly per-tenant delete rehearsal (dry-run)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=kestrel
Group=kestrel
WorkingDirectory=/opt/kestrel
EnvironmentFile=/opt/kestrel/.env

# Rehearsal: dry-run only (no --confirm flag). Proves the script runs,
# connects, and counts rows correctly without deleting anything.
# Real deletions are triggered manually with --confirm for GDPR requests.
ExecStart=/opt/kestrel/scripts/delete-tenant.sh __system__

MemoryMax=512M
TimeoutStartSec=300

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kestrel-tenant-delete
