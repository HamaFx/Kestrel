{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{mjs,ts}", "tools/lighthouse/run.mjs"],
      "project": ["scripts/**/*", "tools/lighthouse/**/*.mjs", "*.json", "*.mjs"]
    },
    "tools/architecture-explorer": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/web": {
      "entry": [
        "src/**/*.{ts,tsx}",
        "test/**/*.{ts,tsx}",
        "test/vitest.setup.ts",
        "next.config.mjs"
      ],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    },
    "apps/worker": {
      "entry": ["src/**/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/ai": {
      "entry": ["src/**/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/data": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/**/*.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/indicators": {
      "entry": ["src/**/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/shared": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/config": {
      "entry": ["eslint/index.js"],
      "project": ["**/*.js"],
      "ignoreUnresolved": ["next"]
    },
    "packages/test-utils": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreBinaries": ["systemd-notify", "where", "xdg-open"],
  "vitest": false,
  "playwright": false,
  "drizzle": false,
  "ignoreDependencies": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss",
    "@vitest/coverage-v8",
    "@vitejs/plugin-react",
    "tailwindcss"
  ]
}
