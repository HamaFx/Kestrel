    "./diagnostics": {"types": "./dist/diagnostics/index.d.ts", "import": "./dist/diagnostics/index.js"},
    "./bot": {"types": "./dist/bot/index.d.ts", "import": "./dist/bot/index.js"},
    "./multi-agent": {"types": "./dist/multi-agent/index.d.ts", "import": "./dist/multi-agent/index.js"},
    "./portfolio": {"types": "./dist/portfolio.d.ts", "import": "./dist/portfolio.js"},
    "./notifications": {"types": "./dist/notifications.d.ts", "import": "./dist/notifications.js"},
    "./types": {"types": "./dist/types.d.ts", "import": "./dist/types.js"},
    "./planner": {"types": "./dist/planner.d.ts", "import": "./dist/planner.js"},
    "./verification": {"types": "./dist/verification.d.ts", "import": "./dist/verification.js"},
    "./catalogue": {"types": "./dist/catalogue.d.ts", "import": "./dist/catalogue.js"},
    "./byok-providers": {"types": "./dist/byok-providers.d.ts", "import": "./dist/byok-providers.js"},
    "./memory": {"types": "./dist/memory/memory-index.d.ts", "import": "./dist/memory/memory-index.js"},
    "./share": {"types": "./dist/share/persistence.d.ts", "import": "./dist/share/persistence.js"},
    "./embeddings": {"types": "./dist/embeddings.d.ts", "import": "./dist/embeddings.js"},
    "./title": {"types": "./dist/title.d.ts", "import": "./dist/title.js"},
    "./rag": {"types": "./dist/rag.d.ts", "import": "./dist/rag.js"},
    "./usage": {"types": "./dist/usage.d.ts", "import": "./dist/usage.js"},
    "./instrumentation": {"types": "./dist/instrumentation.d.ts", "import": "./dist/instrumentation.js"}
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/rewrite-dist-imports.mjs dist",
    "prepublishOnly": "pnpm build",
    "eval": "tsx src/eval/runner.ts --cases",
    "clean": "rm -rf node_modules .turbo"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.79",
    "@ai-sdk/google": "^2.0.74",
    "@ai-sdk/google-vertex": "3.0.139",
    "@ai-sdk/openai-compatible": "^1.0.39",
    "@kestrel/data": "workspace:*",
    "@kestrel/db": "workspace:*",
    "@kestrel/indicators": "workspace:*",
    "@kestrel/shared": "workspace:*",
    "@langfuse/otel": "^5.5.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "ai": "^5.0.0",
    "drizzle-orm": "^0.45.2",
    "react": "^19.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@kestrel/config": "workspace:*",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.17.0",
    "msw": "^2.14.6",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "license": "Apache-2.0"
}
