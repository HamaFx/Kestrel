{
  "name": "@kestrel/plugins",
  "version": "0.0.0",
  "private": true,
  "description": "Kestrel bundled plugin discovery barrel",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/registry.js",
  "types": "./dist/registry.d.ts",
  "exports": {
    ".": {
      "source": "./registry.ts",
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./ui": {
      "source": "./ui-registry.ts",
      "types": "./dist/ui-registry.d.ts",
      "import": "./dist/ui-registry.js"
    }
  },
  "scripts": {
    "lint": "oxlint .",
    "typecheck": "tsrs --noEmit",
    "test": "echo 'no tests for the plugin registry barrel'",
    "build": "tsrs -p tsconfig.build.json && node ../scripts/rewrite-dist-imports.mjs dist",
    "clean": "rm -rf node_modules .turbo dist",
    "test:coverage": "echo 'no coverage for this package'"
  },
  "dependencies": {
    "@kestrel/plugin-backtesting": "workspace:*",
    "@kestrel/plugin-paper-trading": "workspace:*",
    "@kestrel/plugin-sdk": "workspace:*",
    "@kestrel/plugin-telegram-bot": "workspace:*"
  },
  "devDependencies": {
    "@kestrel/config": "workspace:*",
    "@types/node": "^22.20.5",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "^7.0.2"
  }
}
