  "files": ["dist"],
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"},
    "./agent": {"types": "./dist/agent.d.ts", "import": "./dist/agent.js"},
    "./model": {"types": "./dist/model.d.ts", "import": "./dist/model.js"},
    "./cost": {"types": "./dist/cost.d.ts", "import": "./dist/cost.js"},
    "./persistence": {"types": "./dist/persistence.d.ts", "import": "./dist/persistence.js"},
    "./tools": {"types": "./dist/tools/index.d.ts", "import": "./dist/tools/index.js"},
    "./tools/market": {"types": "./dist/tools/market.d.ts", "import": "./dist/tools/market.js"},
    "./tools/analysis": {"types": "./dist/tools/analysis.d.ts", "import": "./dist/tools/analysis.js"},
    "./tools/journal": {"types": "./dist/tools/journal.d.ts", "import": "./dist/tools/journal.js"},
    "./tools/system": {"types": "./dist/tools/system.d.ts", "import": "./dist/tools/system.js"},
    "./tools/web": {"types": "./dist/tools/web.d.ts", "import": "./dist/tools/web.js"},
    "./tools/registry": {"types": "./dist/tools/registry.d.ts", "import": "./dist/tools/registry.js"},
