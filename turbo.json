{
  "globalDependencies": [
    "packages/config/typescript/*.json",
    "packages/config/eslint/*.js"
  ],
  "globalEnv": ["NODE_ENV", "CI", "VERCEL", "NEXT_BUILD_SKIP_TYPECHECK"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!docs/**",
        "!test/**",
        "!tests/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts"
      ],
      "env": [
        "DATABASE_URL",
        "POSTGRES_URL",
        "DIRECT_URL",
        "ADMIN_DATABASE_URL",
        "AUTH_SECRET",
        "CRON_SECRET",
        "ENCRYPTION_SECRET",
        "AI_DEFAULT_MODEL",
        "AI_TITLE_MODEL",
        "AI_EMBEDDING_MODEL",
        "BIQUOTE_BASE_URL",
        "FINNHUB_API_KEY",
        "FRED_API_KEY",
        "WEB_SEARCH_PROVIDER",
        "BRAVE_SEARCH_API_KEY",
        "EXA_API_KEY",
        "TAVILY_API_KEY",
        "TELEGRAM_BOT_TOKEN",
        "RESEND_API_KEY",
        "VAPID_PUBLIC_KEY",
        "VAPID_PRIVATE_KEY",
        "LANGFUSE_PUBLIC_KEY",
        "LANGFUSE_SECRET_KEY",
        "LANGFUSE_BASE_URL",
        "BILLING_ENABLED",
        "NOWPAYMENTS_API_KEY",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "MULTI_USER_ENABLED",
        "KESTREL_ENABLE_RLS",
        "REGISTRATION_MODE",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_VAPID_PUBLIC_KEY",
        "COOKIE_SECURE_MODE",
        "KESTREL_FORCE_EPOCH_BUILD_ID",
        "ANALYZE"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".build-id", ".env.production.local"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["**/*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": [],
      "env": [
        "RUN_POSTGRES_RLS_TESTS",
        "TEST_POSTGRES_ADMIN_URL",
        "RUN_AI_QUEUE_POSTGRES_TESTS",
        "RUN_PG_TESTS",
        "THROTTLE_TEST_DATABASE_URL",
        "THROTTLE_TEST_DATABASE_CONFIRM",
        "DB_DISABLE_SSL",
        "KESTREL_LOCAL_DOCKER"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../scripts/setup/**",
        "../../tools/lighthouse/**",
        "../../loadtest/lib/**",
        "../../loadtest/scripts/**"
      ],
      "outputs": ["coverage/**"]
    },
    "eval": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
