[Unit]
Description=Kestrel Docker container health monitor + auto-restart
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=kestrel
Group=kestrel
ExecStart=/opt/kestrel/scripts/docker-autoheal.sh
# B7: docker restart waits for stop_grace_period (30s in the VM compose)
# before sending SIGKILL, so the total restart can take 35-45s. 90s gives
# a comfortable margin without risking a half-restarted container.
TimeoutStartSec=90

NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kestrel-docker-autoheal