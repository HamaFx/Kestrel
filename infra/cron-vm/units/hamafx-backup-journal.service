[Unit]
Description=Kestrel nightly journal_entries JSON export → B2 (opt-in)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hamafx
Group=hamafx
WorkingDirectory=/opt/hamafx
EnvironmentFile=/opt/kestrel/.env
# Keep this timer installed but skipped until the B2 account is configured.
ExecCondition=/opt/hamafx/scripts/backup-storage-ready.sh
ExecStart=/opt/hamafx/scripts/backup-journal.sh

MemoryMax=256M
TimeoutStartSec=300

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hamafx /tmp

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hamafx-backup-journal
