{
  "name": "@kestrel/plugin-sdk",
  "version": "0.0.0",
  "description": "Kestrel plugin contract, registry and host runtime",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "source": "./src/ui/index.tsx",
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./settings": {
      "source": "./src/settings.ts",
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/rewrite-dist-imports.mjs dist",
    "prepublishOnly": "pnpm build",
    "clean": "rm -rf node_modules .turbo dist"
  },
  "dependencies": {
    "@kestrel/shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kestrel/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "eslint": "^10.13.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "license": "Apache-2.0"
}
