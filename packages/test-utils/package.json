{
  "name": "@kestrel/test-utils",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./factories/*": {
      "source": "./src/factories/*.ts",
      "types": "./dist/factories/*.d.ts",
      "import": "./dist/factories/*.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/rewrite-dist-imports.mjs dist",
    "prepublishOnly": "pnpm build",
    "clean": "rm -rf node_modules .turbo"
  },
  "dependencies": {
    "@kestrel/shared": "workspace:*"
  },
  "devDependencies": {
    "@kestrel/config": "workspace:*",
    "@types/node": "^22.13.0",
    "eslint": "^9.17.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "license": "Apache-2.0"
}
