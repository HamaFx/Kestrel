# Kestrel environment template
# Copy to .env for Docker or .env.local for local development.
# Never commit a file containing real credentials.
#
# Required for production: AUTH_SECRET, CRON_SECRET, ENCRYPTION_SECRET,
# and DATABASE_URL or POSTGRES_URL.
# Local development can auto-generate auth secrets under .kestrel/.

# ── Runtime and public app ───────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=info
LOG_PROMPTS=0

# ── Database ─────────────────────────────────────────────────────────────
# PostgreSQL is required. Start it with `docker compose up -d db` or set DATABASE_URL.
DATABASE_URL=
POSTGRES_URL=
# Use a direct/session connection for migrations, never a transaction pooler.
DIRECT_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL_REPLICA=
ADMIN_DATABASE_URL=
SUPABASE_CA_CERT=
DB_POOL_MAX=5
WORKER_DB_POOL_MAX=3
DB_DISABLE_SSL=false

# ── Authentication and deployment boundary ───────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_COOKIE_SECRET=
CRON_SECRET=
# open = anyone can register; disabled = admin-invite only.
REGISTRATION_MODE=open
MULTI_USER_ENABLED=1
KESTREL_ENABLE_RLS=1
ALLOW_INSECURE_DEV_AUTH=false
ENABLE_DEV_LOGIN=false
ALLOW_DEV_LOGIN_IN_PRODUCTION=false
ENABLE_IMPERSONATION=false

# ── AI server transports (optional; user BYOK keys are configured in-app) ─
AI_GATEWAY_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_DEFAULT_MODEL=openai/gpt-4o
AI_TITLE_MODEL=openai/gpt-4o-mini
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
MAX_DAILY_USD=5
MAX_TOOL_ITERATIONS=6
AI_SEMANTIC_ROUTING_ENABLED=0
# Q4 decision (audit plan): daily spend is ledger-only; never 429. Set 1 to restore the legacy cap.
ENFORCE_BUDGET=0
# Audit v2 §5.3 (Q4): non-blocking admin alert when a user's daily (UTC) ledger spend reaches this.
ADMIN_SPEND_ALERT_USD=25

# ── Audit upgrade-plan feature flags (docs/plans/kestrel-ai-agentic-audit-and-upgrade-plan.md) ─
PHASE2_PACKET_CACHE=1
PHASE3_MODEL_DIVERSITY=0
# Q6 decision: cross-critique ON by default for Full (quality over speed).
ENABLE_COMMITTEE_CRITIQUE=1
PHASE3_STRUCTURED_FUSION=0
# Audit v2 §3.3: optional second committee round (desks may revise after critique).
ENABLE_COMMITTEE_DEBATE=0
# Optional shared Redis for the packet cache (Phase 2.1).
REDIS_URL=

# ── Market data providers (optional) ─────────────────────────────────────
BIQUOTE_BASE_URL=https://biquote.io
BIQUOTE_PROXY_TOKEN=
FINNHUB_API_KEY=
MARKETAUX_API_KEY=
FRED_API_KEY=
SOCIAL_SENTIMENT_API_KEY=
SOCIAL_SENTIMENT_API_URL=
BINANCE_WS_URL=wss://stream.binance.com:9443

# ── Web research providers (optional and disabled by default) ────────────
WEB_SEARCH_ENABLED=0
WEB_SEARCH_PROVIDER=exa
WEB_SEARCH_FALLBACK_PROVIDERS=tavily,brave
WEB_SEARCH_MAX_RESULTS=6
WEB_SEARCH_MAX_CALLS_PER_TURN=2
WEB_SEARCH_CACHE_TTL_SECONDS=600
WEB_SEARCH_TIMEOUT_MS=8000
EXA_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# ── Notifications (optional) ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SECRET_TOKEN=
RESEND_API_KEY=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Storage/uploads (optional; required for chat image uploads) ──────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# ── Optional observability (remote Langfuse) ─────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_RELEASE=
LANGFUSE_TRACING_ENVIRONMENT=
LANGFUSE_RECORD_IO=0

# ── Optional cache ───────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=
THROTTLE_BACKEND=memory

# ── Optional billing (disabled by default — self-host opt-in) ────────────
BILLING_ENABLED=0
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_BASE=https://api-sandbox.nowpayments.io

# ── Docker backups ───────────────────────────────────────────────────────
POSTGRES_PASSWORD=
POSTGRES_VOLUME_NAME=hamafx_pgdata
BACKUP_VOLUME_NAME=hamafx_backup-data
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
BACKUP_MAX_AGE_SECONDS=172800

# ── Worker and operational integrations (optional) ───────────────────────
WORKER_MODE=docker
WORKER_HEALTH_TOKEN=
WORKER_HEALTH_URL=
WORKER_PARTITION=
WORKER_PARTITIONS_TOTAL=
JOB_TIMEOUT_MS=120000
HEALTH_ALERT_WEBHOOK_URL=
HEALTH_ALERT_WEBHOOK_TOKEN=
HEALTH_ALERT_WEBHOOK_TIMEOUT_MS=5000

# ── Retention and local tooling defaults ─────────────────────────────────
TELEMETRY_RETENTION_DAYS=90
TRACE_RETENTION_DAYS=30
RATE_LIMIT_RETENTION_HOURS=2
PROVIDER_DAILY_QUOTA_RETENTION_DAYS=3
CRON_RUN_RETENTION_DAYS=30
ANALYSIS_JOB_RETENTION_DAYS=7
BILLING_WEBHOOK_DLQ_RETENTION_DAYS=90
AI_EVALUATION_RETENTION_DAYS=90
PERSISTENCE_OUTBOX_RETENTION_DAYS=30
BUDGET_RESERVATION_RETENTION_DAYS=90
DATASETS_DIR=
EVAL_REPORTS_DIR=
DEBUG_TRACE_PATH=
ENABLE_LOG_STREAM=false
