[Unit]
Description=Kestrel Docker container health monitor + auto-restart
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=kestrel
Group=kestrel
ExecStart=/opt/kestrel/scripts/docker-autoheal.sh
TimeoutStartSec=30

NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kestrel-docker-autoheal