{
  "globalDependencies": [".env", ".env.local"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "POSTGRES_URL",
    "DIRECT_URL",
    "ADMIN_DATABASE_URL",
    "AUTH_SECRET",
    "CRON_SECRET",
    "ENCRYPTION_SECRET",
    "AI_DEFAULT_MODEL",
    "AI_TITLE_MODEL",
    "AI_EMBEDDING_MODEL",
    "BIQUOTE_BASE_URL",
    "FINNHUB_API_KEY",
    "FRED_API_KEY",
    "WEB_SEARCH_PROVIDER",
    "BRAVE_SEARCH_API_KEY",
    "EXA_API_KEY",
    "TAVILY_API_KEY",
    "TELEGRAM_BOT_TOKEN",
    "RESEND_API_KEY",
    "VAPID_PUBLIC_KEY",
    "VAPID_PRIVATE_KEY",
    "LANGFUSE_PUBLIC_KEY",
    "LANGFUSE_SECRET_KEY",
    "LANGFUSE_BASE_URL",
    "BILLING_ENABLED",
    "NOWPAYMENTS_API_KEY",
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "MULTI_USER_ENABLED",
    "KESTREL_ENABLE_RLS",
    "REGISTRATION_MODE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".build-id", ".env.production.local"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "eval": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
