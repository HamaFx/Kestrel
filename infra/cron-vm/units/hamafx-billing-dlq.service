[Unit]
Description=HamaFX-Ai billing webhook DLQ alert on Vercel
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hamafx
Group=hamafx
EnvironmentFile=/opt/kestrel/.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hamafx
ExecStart=/usr/bin/curl -fsS -m 30 \
  -H "Authorization: Bearer ${CRON_SECRET}" \
  ${PRODUCTION_URL}/api/cron/billing-dlq
ExecStartPost=/bin/sh -c 'test -z "$HC_BILLING_DLQ_UUID" || /usr/bin/curl -fsS -m 5 https://hc-ping.com/$HC_BILLING_DLQ_UUID'

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hamafx-billing-dlq
