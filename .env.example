# Kestrel environment template
# Copy to .env for Docker or .env.local for local development.
# Never commit a file containing real credentials.
#
# Required for production: AUTH_SECRET, CRON_SECRET, ENCRYPTION_SECRET,
# and DATABASE_URL or POSTGRES_URL.
# Local development can auto-generate auth secrets under .kestrel/.

# ── Runtime and public app ───────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=info
LOG_PROMPTS=0

# Service-worker cache identity for `docker compose build`. Build-time only:
# the shell cache name is derived from this id plus a digest of the precached
# asset set, and a repeat of both is what stops an installed app from picking up
# a deploy. Images built without git metadata fall back to an epoch stamp, so
# setting it is recommended for reproducible releases:
#   KESTREL_BUILD_ID=$(git rev-parse --short=7 HEAD) docker compose up -d --build
KESTREL_BUILD_ID=

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL is required. Start it with `docker compose up -d db` or set DATABASE_URL.
DATABASE_URL=
POSTGRES_URL=
# Use a direct/session connection for migrations, never a transaction pooler.
DIRECT_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL_REPLICA=
ADMIN_DATABASE_URL=
SUPABASE_CA_CERT=
DB_POOL_MAX=5
WORKER_DB_POOL_MAX=3
DB_DISABLE_SSL=false
# Durable background jobs (pg-boss). Uses ADMIN_DATABASE_URL when set (needed
# for schema creation in multi-role deployments), otherwise DATABASE_URL.
PGBOSS_SCHEMA=pgboss
PGBOSS_MIGRATE=true

# ── Authentication and deployment boundary ───────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_COOKIE_SECRET=
CRON_SECRET=
# first_user (default) = one public sign-up becomes the admin, then registration
# closes; open = anyone can register (multi-user public instance);
# disabled = admin-invite only.
REGISTRATION_MODE=first_user
# Non-admin accounts never inherit the primary admin's stored BYOK keys unless
# this is 1. Keep 0 so every account brings its own provider key.
ALLOW_SHARED_OPERATOR_KEYS=0
MULTI_USER_ENABLED=1
KESTREL_ENABLE_RLS=1
ALLOW_INSECURE_DEV_AUTH=false
ENABLE_DEV_LOGIN=false
ALLOW_DEV_LOGIN_IN_PRODUCTION=false
ENABLE_IMPERSONATION=false
# Client-visible flags are INLINED INTO THE WEB BUNDLE at build time (Docker
# build args in docker-compose.yml; `pnpm build` env locally). Changing them
# requires a rebuild, not a restart.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false
# Shows the "Continue with Google" button when true (also requires
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET to be configured server-side).
NEXT_PUBLIC_GOOGLE_ENABLED=false

# ── AI server transports (optional; user BYOK keys are configured in-app) ──
# A provider key set here is an operator-paid shared pool: every account can
# use it when it has no personal BYOK key. On a multi-user instance prefer
# per-user keys on /settings/api-keys and leave these empty.
AI_GATEWAY_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_DEFAULT_MODEL=google/gemini-3.5-flash
AI_TITLE_MODEL=google/gemini-3.5-flash-lite
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
MAX_DAILY_USD=5
MAX_TOOL_ITERATIONS=6
AI_SEMANTIC_ROUTING_ENABLED=0
# Daily AI cap is enforced: turns that would cross MAX_DAILY_USD are rejected
# with 429. Set 0 for ledger-only observation (audit 2026-10-31 R3).
ENFORCE_BUDGET=1
# Audit v2 §5.3 (Q4): non-blocking admin alert when a user's daily (UTC) ledger spend reaches this.
ADMIN_SPEND_ALERT_USD=25

# ── Audit upgrade-plan feature flags (docs/plans/kestrel-ai-agentic-audit-and-upgrade-plan.md) ──
PHASE2_PACKET_CACHE=1
PHASE3_MODEL_DIVERSITY=0
PHASE3_STRUCTURED_FUSION=1
# M-02 (audit 2026-10-18): generic macro packet (news/calendar/COT) for non-XAUUSD
# symbols. ON by default; set 0 to roll back to the candle-only packet.
ENABLE_GENERIC_MACRO=1
# P1-04 (audit 2026-10-18): run technical + risk desks per symbol in comparisons.
ENABLE_COMPARISON_RISK_DESK=1
# Optional shared Redis for the packet cache (Phase 2.1).
REDIS_URL=

# ── Market data providers (optional) ─────────────────────────────────────────
BIQUOTE_BASE_URL=https://biquote.io
BIQUOTE_PROXY_TOKEN=
FINNHUB_API_KEY=
MARKETAUX_API_KEY=
FRED_API_KEY=
SOCIAL_SENTIMENT_API_KEY=
SOCIAL_SENTIMENT_API_URL=
BINANCE_WS_URL=wss://stream.binance.com:9443

# ── Web research providers (optional and disabled by default) ─────────────────
WEB_SEARCH_ENABLED=0
WEB_SEARCH_PROVIDER=exa
WEB_SEARCH_FALLBACK_PROVIDERS=tavily,brave
WEB_SEARCH_MAX_RESULTS=6
WEB_SEARCH_MAX_CALLS_PER_TURN=2
WEB_SEARCH_CACHE_TTL_SECONDS=600
WEB_SEARCH_TIMEOUT_MS=8000
# Indirect-injection screening posture for web results (audit R15).
# Instruction-like snippets are withheld in every posture; the value is
# recorded in the run report and telemetry.
WEB_SEARCH_SCREEN_MODE=strict
EXA_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# ── Notifications (optional) ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SECRET_TOKEN=
# Optional: dedicated secret for signing Telegram plugin link/webhook tokens.
# Falls back to AUTH_SECRET then ENCRYPTION_SECRET. Set a 32+ char random value.
TELEGRAM_PLUGIN_SECRET=
RESEND_API_KEY=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Storage/uploads (optional; required for chat image uploads) ──────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# ── Optional observability (remote Langfuse) ─────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_RELEASE=
LANGFUSE_TRACING_ENVIRONMENT=
LANGFUSE_RECORD_IO=0

# ── Optional cache ───────────────────────────────────────────────────────────
# REDIS_URL is documented with the feature flags above.
THROTTLE_BACKEND=memory

# ── Docker backups ───────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
# Password for the BYPASSRLS maintenance role (ADMIN_DATABASE_URL) on Docker volumes.
POSTGRES_ADMIN_PASSWORD=
# Credential for the dedicated kestrel_app role (LOGIN, NOBYPASSRLS). The web
# app and worker always connect as this role; a superuser connection bypasses
# row-level security. `./docker/init-secrets.sh` generates it, and the runtime
# migrator (re)provisions the role for existing volumes. See docs/configuration.md.
POSTGRES_APP_PASSWORD=
POSTGRES_VOLUME_NAME=hamafx_pgdata
BACKUP_VOLUME_NAME=hamafx_backup-data
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
BACKUP_MAX_AGE_SECONDS=172800

# ── Worker and operational integrations (optional) ───────────────────────────
WORKER_MODE=docker
# 0 = 100% on-demand BiQuote REST mode (default); 1 = legacy 24/7 SignalR/Binance DB tick stream.
WORKER_ENABLE_TICK_STREAM=0
WORKER_HEALTH_TOKEN=
WORKER_HEALTH_URL=
WORKER_PARTITION=
WORKER_PARTITIONS_TOTAL=
JOB_TIMEOUT_MS=120000
HEALTH_ALERT_WEBHOOK_URL=
HEALTH_ALERT_WEBHOOK_TOKEN=
HEALTH_ALERT_WEBHOOK_TIMEOUT_MS=5000

# ── Retention and local tooling defaults ─────────────────────────────────────
TELEMETRY_RETENTION_DAYS=90
TRACE_RETENTION_DAYS=30
RATE_LIMIT_RETENTION_HOURS=2
PROVIDER_DAILY_QUOTA_RETENTION_DAYS=3
CRON_RUN_RETENTION_DAYS=30
CANDLES_1M_RETENTION_DAYS=14
BUDGET_RESERVATION_RETENTION_DAYS=90
DEBUG_TRACE_PATH=
ENABLE_LOG_STREAM=false
