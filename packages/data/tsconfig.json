{
  "extends": "@kestrel/config/typescript/base",
  "compilerOptions": {
    "paths": {
      // P-02 (audit 2026-10-18) — intra-package alias so deep relative
      // imports (`../../../cache/throttle`) can become `@data/cache/throttle`.
      // `scripts/rewrite-dist-imports.mjs` rewrites `@data/*` back to relative
      // specifiers when publishing, and vitest.config.ts aliases it for tests.
      "@data/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
