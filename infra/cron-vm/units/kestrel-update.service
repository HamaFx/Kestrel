[Unit]
Description=Kestrel self-update (git pull + Docker build + container restart)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=kestrel
Group=kestrel
WorkingDirectory=/opt/kestrel
EnvironmentFile=/opt/kestrel/.env
ExecStart=/opt/kestrel/scripts/docker-update.sh
TimeoutStartSec=600

# Docker needs NoNewPrivileges=false (kestrel is in docker group)
NoNewPrivileges=false

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kestrel-update
