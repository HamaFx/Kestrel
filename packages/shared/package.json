{
  "name": "@kestrel/shared",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@kestrel/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": {
      "@kestrel/source": "./src/schemas/*.ts",
      "types": "./dist/schemas/*.d.ts",
      "import": "./dist/schemas/*.js"
    },
    "./ai/*": {
      "@kestrel/source": "./src/ai/*.ts",
      "types": "./dist/ai/*.d.ts",
      "import": "./dist/ai/*.js"
    },
    "./byok": {
      "@kestrel/source": "./src/crypto/byok.ts",
      "types": "./dist/crypto/byok.d.ts",
      "import": "./dist/crypto/byok.js"
    },
    "./env": {
      "@kestrel/source": "./src/env/index.ts",
      "types": "./dist/env/index.d.ts",
      "import": "./dist/env/index.js"
    },
    "./env-secrets": {
      "@kestrel/source": "./src/env/secrets.ts",
      "types": "./dist/env/secrets.d.ts",
      "import": "./dist/env/secrets.js"
    },
    "./vault": {
      "@kestrel/source": "./src/crypto/vault.ts",
      "types": "./dist/crypto/vault.d.ts",
      "import": "./dist/crypto/vault.js"
    },
    "./errors": {
      "@kestrel/source": "./src/errors/index.ts",
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./encryption": {
      "@kestrel/source": "./src/crypto/encryption.ts",
      "types": "./dist/crypto/encryption.d.ts",
      "import": "./dist/crypto/encryption.js"
    },
    "./logger": {
      "@kestrel/source": "./src/logger/index.ts",
      "types": "./dist/logger/index.d.ts",
      "import": "./dist/logger/index.js"
    },
    "./tenant-partition": {
      "@kestrel/source": "./src/runtime/tenant-partition.ts",
      "types": "./dist/runtime/tenant-partition.d.ts",
      "import": "./dist/runtime/tenant-partition.js"
    },
    "./metrics-export": {
      "@kestrel/source": "./src/metrics-export/index.ts",
      "types": "./dist/metrics-export/index.d.ts",
      "import": "./dist/metrics-export/index.js"
    }
  },
  "scripts": {
    "lint": "oxlint .",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run",
    "build": "tsrs -p tsconfig.build.json && node ../../scripts/rewrite-dist-imports.mjs dist",
    "prepublishOnly": "pnpm build",
    "clean": "rm -rf node_modules .turbo dist",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "pino": "^10.4.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kestrel/config": "workspace:*",
    "@types/node": "^22.20.5",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
