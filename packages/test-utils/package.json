{
  "name": "@kestrel/test-utils",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@kestrel/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./factories/*": {
      "@kestrel/source": "./src/factories/*.ts",
      "types": "./dist/factories/*.d.ts",
      "import": "./dist/factories/*.js"
    }
  },
  "scripts": {
    "lint": "oxlint .",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run",
    "build": "tsrs -p tsconfig.build.json && node ../../scripts/rewrite-dist-imports.mjs dist",
    "prepublishOnly": "pnpm build",
    "clean": "rm -rf node_modules .turbo dist",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@kestrel/shared": "workspace:*",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@kestrel/config": "workspace:*",
    "@types/node": "^22.20.5",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
