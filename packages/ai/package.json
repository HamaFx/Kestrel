{
  "name": "@kestrel/ai",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@kestrel/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cost": {
      "@kestrel/source": "./src/budget/cost.ts",
      "types": "./dist/budget/cost.d.ts",
      "import": "./dist/budget/cost.js"
    },
    "./persistence": {
      "@kestrel/source": "./src/persistence/index.ts",
      "types": "./dist/persistence/index.d.ts",
      "import": "./dist/persistence/index.js"
    },
    "./cron": {
      "@kestrel/source": "./src/cron/index.ts",
      "types": "./dist/cron/index.d.ts",
      "import": "./dist/cron/index.js"
    },
    "./mastra-v2": {
      "@kestrel/source": "./src/mastra-v2/index.ts",
      "types": "./dist/mastra-v2/index.d.ts",
      "import": "./dist/mastra-v2/index.js"
    },
    "./plugins": {
      "@kestrel/source": "./src/plugins/index.ts",
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./instrumentation": {
      "@kestrel/source": "./src/runtime/instrumentation.ts",
      "types": "./dist/runtime/instrumentation.d.ts",
      "import": "./dist/runtime/instrumentation.js"
    }
  },
  "scripts": {
    "lint": "oxlint .",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run",
    "build": "tsrs -p tsconfig.build.json && node ../../scripts/rewrite-dist-imports.mjs dist",
    "prepublishOnly": "pnpm build",
    "eval": "tsx src/eval/runner.ts --cases",
    "eval:gate": "tsx --conditions=react-server scripts/eval-gate.ts",
    "mastra:dev": "mastra dev",
    "mastra:studio": "node --conditions=react-server dist/mastra-v2/studio-server.js",
    "mastra:build": "mastra build",
    "mastra:start": "mastra start",
    "mastra:migrate": "mastra migrate",
    "clean": "rm -rf node_modules .turbo dist",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/google": "^4.0.99",
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@ai-sdk/otel": "^1.0.143",
    "@ai-sdk/provider-utils": "^5.0.62",
    "@kestrel/data": "workspace:*",
    "@kestrel/db": "workspace:*",
    "@kestrel/indicators": "workspace:*",
    "@kestrel/plugin-sdk": "workspace:*",
    "@kestrel/shared": "workspace:*",
    "@langfuse/otel": "^6.0.0",
    "@mastra/core": "^1.78.0",
    "@mastra/deployer": "^1.78.0",
    "@mastra/evals": "^1.10.7",
    "@mastra/langfuse": "1.6.1",
    "@mastra/libsql": "^1.26.2",
    "@mastra/memory": "^1.38.0",
    "@mastra/observability": "1.20.1",
    "@mastra/pg": "^1.31.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.223.0",
    "ai": "^7.0.143",
    "drizzle-orm": "^1.0.0-rc.5",
    "react": "^19.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kestrel/config": "workspace:*",
    "@kestrel/test-utils": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "mastra": "^1.34.2",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "ioredis": "^5.11.1"
  }
}
