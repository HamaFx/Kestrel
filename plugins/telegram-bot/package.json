{
  "name": "@kestrel/plugin-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Run Kestrel from Telegram: commands, alerts, and scheduled briefings.",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@kestrel/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "@kestrel/source": "./src/ui/index.tsx",
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "scripts": {
    "lint": "oxlint .",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run",
    "build": "tsrs -p tsconfig.build.json && node ../../scripts/rewrite-dist-imports.mjs dist",
    "clean": "rm -rf node_modules .turbo dist",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@kestrel/ai": "workspace:*",
    "@kestrel/data": "workspace:*",
    "@kestrel/db": "workspace:*",
    "@kestrel/plugin-paper-trading": "workspace:*",
    "@kestrel/plugin-sdk": "workspace:*",
    "@kestrel/shared": "workspace:*",
    "@tabler/icons-react": "^3.50.0",
    "ai": "^7.0.143",
    "drizzle-orm": "^1.0.0-rc.5",
    "grammy": "^1.46.0",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kestrel/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "next": "16.4.2",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
