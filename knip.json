{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.{mjs,ts}",
        "scripts/setup/index.mjs",
        "scripts/setup/lib/generate-env.mjs",
        "tools/lighthouse/run.mjs"
      ],
      "project": ["scripts/**/*.{mjs,ts}", "tools/lighthouse/**/*.mjs"]
    },
    "apps/web": {
      "entry": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}", "test/vitest.setup.ts", "src/**/*.css"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}", "src/**/*.css"]
    },
    "apps/worker": {
      "entry": ["src/**/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/ai": {
      "entry": ["src/**/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/data": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/**/*.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/indicators": {
      "entry": ["src/**/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/shared": {
      "entry": [
        "src/index.ts",
        "src/schemas/*.ts",
        "src/ai/*.ts",
        "src/byok.ts",
        "src/env.ts",
        "src/env-secrets.ts",
        "src/vault.ts",
        "src/errors.ts",
        "src/encryption.ts",
        "src/logger.ts",
        "src/metrics-export.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "packages/config": {
      "entry": [],
      "project": ["eslint/**/*.js"],
      "ignoreUnresolved": ["next"]
    },
    "packages/test-utils": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreBinaries": ["systemd-notify", "where", "xdg-open"],
  "vitest": false,
  "playwright": false,
  "drizzle": false,
  "ignoreDependencies": ["@vitest/coverage-v8", "@vitejs/plugin-react"]
}
