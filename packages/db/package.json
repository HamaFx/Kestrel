{
  "name": "@kestrel/db",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "source": "./src/schema/index.ts",
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./client": {
      "source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./queue": {
      "source": "./src/queue/index.ts",
      "types": "./dist/queue/index.d.ts",
      "import": "./dist/queue/index.js"
    }
  },
  "scripts": {
    "lint": "oxlint .",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run",
    "build": "tsrs -p tsconfig.build.json && node ../../scripts/rewrite-dist-imports.mjs dist",
    "prepublishOnly": "pnpm build",
    "clean": "rm -rf node_modules .turbo dist",
    "migrate:gen": "drizzle-kit generate",
    "migrate:gen:custom": "drizzle-kit generate --custom",
    "migrate:apply": "node scripts/install-extensions.mjs && node scripts/migrate-apply.mjs",
    "provision:app-role": "node scripts/provision-app-role.mjs",
    "migrate:status": "node scripts/migrate-status.mjs",
    "migrate:reconcile": "node scripts/migration-reconcile.mjs",
    "migrate:rotate-encryption": "node scripts/rotate-encryption-secret.mjs",
    "migrate:setup-extensions": "node scripts/install-extensions.mjs",
    "inventory:live": "node scripts/supabase-inventory.mjs",
    "seed:plans": "tsx scripts/seed-plans.ts",
    "seed:billing": "tsx scripts/seed-billing.ts",
    "studio": "drizzle-kit studio",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@kestrel/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg-boss": "^12.38.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@kestrel/config": "workspace:*",
    "@kestrel/test-utils": "workspace:*",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
