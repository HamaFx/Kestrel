{
  "$comment": "Single source of truth for Docker/.env secrets. Consumed by scripts/setup/lib/secrets.mjs and scripts/setup/lib/generate-env.mjs. docker/init-secrets.sh delegates to generate-env.mjs so there is exactly one generator.",
  "defaults": {
    "POSTGRES_PASSWORD": { "type": "random", "bytes": 16 },
    "POSTGRES_VOLUME_NAME": "hamafx_pgdata",
    "BACKUP_VOLUME_NAME": "hamafx_backup-data",
    "BACKUP_INTERVAL_SECONDS": "86400",
    "BACKUP_RETENTION_DAYS": "7",
    "BACKUP_MAX_AGE_SECONDS": "172800",
    "LANGFUSE_NEXTAUTH_SECRET": { "type": "random", "bytes": 32 },
    "LANGFUSE_SALT": { "type": "random", "bytes": 16 },
    "AUTH_SECRET": { "type": "random", "bytes": 32 },
    "NEXTAUTH_URL": "http://localhost:3000",
    "CRON_SECRET": { "type": "random", "bytes": 16 },
    "ENCRYPTION_SECRET": { "type": "random", "bytes": 32 },
    "BYOK_ENABLED": "1",
    "MULTI_USER_ENABLED": "0",
    "REGISTRATION_MODE": "owner-first",
    "KESTREL_ENABLE_RLS": "0",
    "OSS_SINGLE_USER_MODE": "1",
    "WORKER_HEALTH_TOKEN": { "type": "random", "bytes": 32 },
    "BIQUOTE_PROXY_TOKEN": { "type": "random", "bytes": 32 }
  }
}
