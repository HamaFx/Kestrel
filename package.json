{
  "name": "kestrel",
  "version": "0.1.0",
  "description": "The Self-Hosted Multi-User BYOK AI Trading Platform",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "tsx scripts/dev.ts && turbo run dev",
    "setup": "node scripts/setup.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test:watch": "turbo run test -- --watch",
    "test:coverage": "turbo run test -- --coverage",
    "test:e2e": "pnpm --filter @kestrel/web exec playwright test",
    "test:e2e:local": "node scripts/run-e2e-local.mjs",
    "test:web": "pnpm --filter @kestrel/web test",
    "test:ai": "pnpm --filter @kestrel/ai test",
    "test:shared": "pnpm --filter @kestrel/shared test",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:empty-guard": "node scripts/check-test-files.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:local": "node scripts/verify-local-env.mjs",
    "check:compose-reproducibility": "node scripts/check-compose-reproducibility.mjs",
    "check:compose-images": "node scripts/check-compose-images.mjs",
    "check:route-security": "node scripts/check-route-security.mjs",
    "check:env-contract": "node scripts/check-env-contract.mjs",
    "test:postgres-rls": "node scripts/run-postgres-rls-test.mjs",
    "test:ai-postgres-queue": "node scripts/run-ai-postgres-queue-test.mjs",
    "docker:prune": "node scripts/docker-prune-safe.mjs",
    "build:packages": "turbo run build --filter=@kestrel/shared --filter=@kestrel/indicators --filter=@kestrel/db --filter=@kestrel/data --filter=@kestrel/ai --filter=@kestrel/test-utils --filter=@kestrel/loadtest",
    "knip": "knip",
    "eval:gate": "pnpm --filter @kestrel/ai run eval:gate"
  },
  "dependencies": {
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.4.0",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.2.7",
    "chrome-launcher": "^1.2.1",
    "knip": "^6.32.1",
    "lighthouse": "^13.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tsx": "^4.22.4",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "patchedDependencies": {
      "eventsource-parser@3.0.8": "patches/eventsource-parser@3.0.8.patch",
      "eventsource-parser@3.1.1": "patches/eventsource-parser@3.1.1.patch"
    }
  }
}
