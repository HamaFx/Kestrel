[Unit]
Description=Kestrel weekly per-tenant export rehearsal → B2 (opt-in)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=kestrel
Group=kestrel
WorkingDirectory=/opt/kestrel
EnvironmentFile=/opt/kestrel/.env
# Keep the rehearsal installed but skipped until B2 is configured.
ExecCondition=/opt/kestrel/scripts/backup-storage-ready.sh

# Rehearsal: export the __system__ tenant (always exists, small dataset).
# In production with real tenants, a separate cron or manual trigger should
# iterate over all active users. This unit proves the pipeline works weekly.
ExecStart=/opt/kestrel/scripts/export-tenant.sh __system__

MemoryMax=512M
TimeoutStartSec=300

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kestrel-tenant-export
