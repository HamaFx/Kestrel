[Unit]
Description=Kestrel light cron — POST /api/cron/calendar on Vercel
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=kestrel
Group=kestrel
EnvironmentFile=/opt/kestrel/.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/kestrel
ExecStart=/usr/bin/curl -fsS -m 30 \
  -H "Authorization: Bearer ${CRON_SECRET}" \
  ${PRODUCTION_URL}/api/cron/calendar
ExecStartPost=/bin/sh -c 'test -z "$HC_LIGHT_CALENDAR_UUID" || /usr/bin/curl -fsS -m 5 https://hc-ping.com/$HC_LIGHT_CALENDAR_UUID'

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kestrel-light-calendar
