{
  "name": "@kestrel/data",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@kestrel/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/*": {
      "@kestrel/source": "./src/adapters/*.ts",
      "types": "./dist/adapters/*.d.ts",
      "import": "./dist/adapters/*.js"
    },
    "./cache": {
      "@kestrel/source": "./src/cache/index.ts",
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js"
    },
    "./providers/*": {
      "@kestrel/source": "./src/providers/*/index.ts",
      "types": "./dist/providers/*/index.d.ts",
      "import": "./dist/providers/*/index.js"
    }
  },
  "scripts": {
    "lint": "oxlint .",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run",
    "build": "tsrs -p tsconfig.build.json && node ../../scripts/rewrite-dist-imports.mjs dist",
    "prepublishOnly": "pnpm build",
    "clean": "rm -rf node_modules .turbo dist",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@kestrel/db": "workspace:*",
    "@kestrel/shared": "workspace:*",
    "drizzle-orm": "^1.0.0-rc.5",
    "redis": "^6.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kestrel/config": "workspace:*",
    "@types/node": "^22.20.5",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
