{
  "name": "@kestrel/plugin-custom-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "source": "./src/ui/index.tsx",
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/rewrite-dist-imports.mjs dist",
    "clean": "rm -rf node_modules .turbo dist"
  },
  "dependencies": {
    "@kestrel/db": "workspace:*",
    "@kestrel/plugin-sdk": "workspace:*",
    "@kestrel/shared": "workspace:*",
    "@mastra/core": "^1.78.0",
    "@mastra/mcp": "^1.18.0",
    "@tabler/icons-react": "^3.49.0",
    "drizzle-orm": "^0.45.4",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.3.1",
    "unpdf": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kestrel/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "eslint": "^10.13.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "description": "User-created standalone Mastra agents with skills, tool allowlists, @mentions and MCP.",
  "license": "Apache-2.0"
}
