# Allow the `kestrel` user to restart the worker service and Docker without a
# password. Required by infra/cron-vm/scripts/docker-update.sh — the self-update
# timer runs as `kestrel` but needs to restart the worker container.
#
# Install path: /etc/sudoers.d/kestrel (mode 0440).
# Validate before installing: `visudo -c -f infra/cron-vm/sudoers.d/kestrel`.

kestrel ALL=(root) NOPASSWD: /bin/systemctl restart docker
kestrel ALL=(root) NOPASSWD: /bin/systemctl restart kestrel-worker
kestrel ALL=(root) NOPASSWD: /usr/bin/bash /usr/local/sbin/kestrel-sync-systemd-units
