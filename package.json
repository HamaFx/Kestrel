{
  "name": "kestrel",
  "version": "0.0.0",
  "description": "The Open-Source, Single-User BYOK AI Trading Platform",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:local": "tsx scripts/dev.ts",
    "setup": "node scripts/setup.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test:watch": "turbo run test -- --watch",
    "test:coverage": "turbo run test -- --coverage",
    "test:e2e": "pnpm --filter @kestrel/web exec playwright test",
    "test:e2e:local": "node scripts/run-e2e-local.mjs",
    "test:web": "pnpm --filter @kestrel/web test",
    "test:ai": "pnpm --filter @kestrel/ai test",
    "test:shared": "pnpm --filter @kestrel/shared test",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:empty-guard": "node scripts/check-test-files.mjs",
    "check-console-errors": "node scripts/check-console-errors.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:local": "node scripts/verify-local-env.mjs",
    "check:oss-release": "node scripts/check-oss-release.mjs",
    "check:p0-release": "node scripts/check-p0-release.mjs",
    "check:git-history-secrets": "node scripts/check-git-history-secrets.mjs",
    "check:compose-reproducibility": "node scripts/check-compose-reproducibility.mjs",
    "check:compose-images": "node scripts/check-compose-images.mjs",
    "check:p3-release": "node scripts/check-p3-release.mjs",
    "check:route-security": "node scripts/check-route-security.mjs",
    "check:env-contract": "node scripts/check-env-contract.mjs",
    "check:release-archive": "node scripts/check-release-archive.mjs",
    "generate:sbom": "node scripts/generate-sbom.mjs",
    "check:dependency-report": "node scripts/check-dependency-report.mjs",
    "docker:prune": "node scripts/docker-prune-safe.mjs",
    "eval:publish": "node scripts/publish-langfuse-eval.mjs",
    "build:packages": "pnpm --filter @kestrel/shared build && pnpm --filter @kestrel/indicators build && pnpm --filter @kestrel/db build && pnpm --filter @kestrel/data build && pnpm --filter @kestrel/ai build && pnpm --filter @kestrel/test-utils build",
    "publish-packages": "pnpm build:packages && changeset publish",
    "knip": "knip"
  },
  "dependencies": {
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.0",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.2.7",
    "chrome-launcher": "^1.2.1",
    "knip": "^6.32.1",
    "lighthouse": "^13.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tsx": "^4.22.4",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2"
  }
}
