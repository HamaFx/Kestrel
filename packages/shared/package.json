{
  "name": "@kestrel/shared",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": {
      "types": "./dist/schemas/*.d.ts",
      "import": "./dist/schemas/*.js"
    },
    "./ai/*": {
      "types": "./dist/ai/*.d.ts",
      "import": "./dist/ai/*.js"
    },
    "./byok": {
      "types": "./dist/byok.d.ts",
      "import": "./dist/byok.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js"
    },
    "./env-secrets": {
      "types": "./dist/env-secrets.d.ts",
      "import": "./dist/env-secrets.js"
    },
    "./vault": {
      "types": "./dist/vault.d.ts",
      "import": "./dist/vault.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./encryption": {
      "types": "./dist/encryption.d.ts",
      "import": "./dist/encryption.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js"
    },
    "./metrics-export": {
      "types": "./dist/metrics-export.d.ts",
      "import": "./dist/metrics-export.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/rewrite-dist-imports.mjs dist",
    "prepublishOnly": "pnpm build",
    "clean": "rm -rf node_modules .turbo"
  },
  "dependencies": {
    "pino": "^10.3.1",
    "server-only": "^0.0.1",
    "snappyjs": "^0.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@kestrel/config": "workspace:*",
    "@types/node": "^22.13.0",
    "eslint": "^9.17.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "license": "Apache-2.0"
}
