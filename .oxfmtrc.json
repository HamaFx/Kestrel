{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "arrowParens": "always",
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "**/*.tsbuildinfo",
    "packages/db/drizzle/**",
    "**/next-env.d.ts",
    "**/*.yml",
    "**/*.yaml",
    "docs/audit/**"
  ]
}
