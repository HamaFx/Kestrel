{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.{mjs,ts}",
        "scripts/setup/index.mjs",
        "scripts/setup/lib/generate-env.mjs",
        "tools/lighthouse/run.mjs"
      ],
      "project": ["scripts/**/*.{mjs,ts}", "tools/lighthouse/**/*.mjs"]
    },
    "apps/web": {
      "entry": [
        "src/app/**/{page,layout,loading,error,global-error,not-found,manifest,route,opengraph-image}.{ts,tsx}",
        "src/app/**/actions.ts",
        "scripts/**/*.mjs",
        "test/**/*.{test,spec}.{ts,tsx}",
        "test/vitest.setup.ts",
        "tests/**/*.spec.ts",
        "test/vitest.node-setup.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}", "src/**/*.css"]
    },
    "apps/worker": {
      "entry": ["src/runner/cli.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/ai": {
      "entry": ["src/mastra-v2/studio-server.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/data": {
      "entry": ["src/adapters/*.ts", "src/providers/*/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/db": {
      "entry": ["scripts/**/*.mjs", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.{ts,mjs}", "test/**/*.ts"]
    },
    "packages/indicators": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/plugin-sdk": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts"]
    },
    "packages/shared": {
      "entry": ["src/schemas/*.ts", "src/ai/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/test-utils": {
      "entry": ["src/factories/*.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "plugins": {
      "project": ["*.ts"]
    },
    "plugins/backtesting": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts"]
    },
    "plugins/paper-trading": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts"]
    },
    "plugins/telegram-bot": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts"]
    },
    "loadtest": {
      "entry": [
        "tests/*.ts",
        "scenarios/**/*.ts",
        "config/**/*.ts",
        "lib/**/*.ts",
        "scripts/*.mjs",
        "lib/seed/*.mjs"
      ],
      "project": ["**/*.{ts,mjs}"],
      "ignoreDependencies": ["k6", "drizzle-orm"],
      "ignoreBinaries": ["k6"]
    }
  },
  "ignoreBinaries": ["systemd-notify", "where", "xdg-open"],
  "vitest": false,
  "playwright": false,
  "drizzle": false,
  "ignoreDependencies": ["@vitejs/plugin-react", "vite", "pg-boss"]
}
